# Configuración del despliegue con Docker (se lee con `docker compose`). Copiar a .env y completar.
# NUNCA subir el .env a git.

# Dirección con la que los usuarios abren el sistema. Sin dominio: http://IP-DEL-SERVIDOR (sin barra al final).
# Si cambia el puerto de abajo (HTTP_PORT), incluirlo: http://IP-DEL-SERVIDOR:8080
PUBLIC_URL=http://192.168.1.50

# Puerto publicado en el servidor (80 por defecto).
HTTP_PORT=80

# Contraseña de la base de datos y secreto de los tokens: valores largos y aleatorios.
#   openssl rand -hex 24      (para la contraseña)
#   openssl rand -hex 48      (para JWT_SECRET)
DB_PASSWORD=cambiar-esta-contrasena
JWT_SECRET=cambiar-este-secreto-por-uno-largo-y-aleatorio

# Opcionales (valores por defecto entre paréntesis)
# JWT_EXPIRES_IN=8h
# INACTIVIDAD_TIMEOUT_MIN=10

# Correo (SMTP). Vacío = no se envía nada real; los códigos y enlaces salen en el log del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Integración con Ruah (solo lectura) y correos masivos: dejar apagados mientras se prueba.
RUAH_DATABASE_URL=
RUAH_ENVIAR_CORREOS=false
CORREOS_AVISOS_ACTIVOS=false
