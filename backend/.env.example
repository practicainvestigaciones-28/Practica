# Conexión a PostgreSQL 13
DATABASE_URL="postgresql://postgres:xd@localhost:5432/vicerrectoria_investigacion?schema=public"

# Puerto donde corre el servidor Express
PORT=3000

# Secretos JWT — usa un valor largo y aleatorio en tu .env real, nunca este de ejemplo.
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Origen permitido para CORS (URL del frontend en React/Vite)
CORS_ORIGIN="http://localhost:5173"

# Rondas de salt para bcrypt
BCRYPT_SALT_ROUNDS=10

NODE_ENV="development"

# RQF03 - Recuperación de contraseña
RESET_TOKEN_EXPIRES_MIN=60
FRONTEND_RESET_URL="http://localhost:5173/restablecer-contrasena"
