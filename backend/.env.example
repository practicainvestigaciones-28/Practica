# Conexión a PostgreSQL 13
DATABASE_URL="postgresql://postgres:xd@localhost:5432/vicerrectoria_investigacion?schema=public"

# Puerto donde corre el servidor Express
PORT=3000

# Secretos JWT — usa un valor largo y aleatorio en tu .env real, nunca este de ejemplo.
# Puedes generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"

# Origen permitido para CORS (URL del frontend en React/Vite)
CORS_ORIGIN="http://localhost:5173"

# Rondas de salt para bcrypt
BCRYPT_SALT_ROUNDS=10

NODE_ENV="development"

# RQF03 - Recuperación de contraseña
RESET_TOKEN_EXPIRES_MIN=60
FRONTEND_RESET_URL="http://localhost:5173/restablecer-contrasena"

# RQF04 - minutos de inactividad antes de cerrar la sesión automáticamente
# (independiente de JWT_EXPIRES_IN, que es el tope máximo absoluto del token)
INACTIVIDAD_TIMEOUT_MIN=30

# Envío de correo (bienvenida al crear un usuario, recuperación de contraseña).
# Si se deja SMTP_HOST vacío, el sistema no manda ningún correo real: solo
# deja el contenido en la consola del backend, para poder probar sin SMTP.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu correo,
# SMTP_PASS=una "contraseña de aplicación" (no la contraseña normal de la
# cuenta) generada desde la configuración de seguridad de Gmail.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Remitente que verán los correos — si se deja vacío, usa SMTP_USER.
SMTP_FROM=""

# URL del login del frontend, para el enlace que va en el correo de bienvenida.
FRONTEND_LOGIN_URL=""

# Acta de inicio: firma individual por correo. El enlace del correo lleva a esta
# página del frontend (se le agrega /<token>) y vence a los N días.
FRONTEND_FIRMA_ACTA_URL="http://localhost:5173/firmar-acta"
ACTA_FIRMA_VIGENCIA_DIAS=7
# El Vicerrector solo firma (sin cuenta ni rol): su enlace llega a este correo.
# Se puede cambiar al generar cada acta.
VICERRECTOR_NOMBRE="Vicerrector de Investigación y Extensión"
VICERRECTOR_CORREO=""

# Firma de participantes al registrar el proyecto (RQF13): mismo patrón de
# enlace personal por correo que el acta de inicio.
FRONTEND_FIRMA_PROYECTO_URL="http://localhost:5173/firmar-proyecto"
