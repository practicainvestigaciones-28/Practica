generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id_usuario           Int                 @id @default(autoincrement())
  nombre               String
  apellido             String
  correo               String              @unique
  contraseña          String
  codigo               String?
  cedula               String?
  // RQF05 - permite al Administrador desactivar una cuenta sin borrarla
  // (bloquea el login; ver auth.service.ts).
  activo               Boolean             @default(true)
  convocatoriasCreadas Convocatoria[]
  proyectosCreados     Proyecto[]
  roles                RolesUsuario[]
  tokensRecuperacion   TokenRecuperacion[]
  participaciones      UsuarioProyecto[]
  actividadesResponsable CronogramaActividad[]
  hojaVida               HojaVida?
    documentosCargados     ProyectoDocumento[]
  sesiones               SesionUsuario[]
  notificaciones         Notificacion[]
  datosBancarios         DatoBancarioPar[]
  asignacionesRecibidas  AsignacionRevision[] @relation("AsignadoA")
  asignacionesRealizadas AsignacionRevision[] @relation("AsignadoPor")
  evaluacionesRealizadas EvaluacionEtapa[]
  cambiosEtapaEstado     HistorialEtapaEstado[]
  observacionesRealizadas ObservacionProyecto[]
  reclamacionesRealizadas Reclamacion[] @relation("UsuarioReclamante")
  reclamacionesRespondidas Reclamacion[] @relation("UsuarioRespuesta")
  pagosRegistrados       PagoPar[]

  // Relaciones con Etapa de Seguimiento (v2)
  actasInicioGeneradas            ActaInicio[]
  firmasRealizadas                FirmaDocumento[]
  solicitudesRubroRealizadas      SolicitudRubro[]          @relation("SolicitadoPor")
  solicitudesRubroDecididas       SolicitudRubro[]          @relation("DecididoPor")
  ejecucionesPresupuestales       EjecucionPresupuestal[]
  actividadesResponsableSeguimiento InformeAvanceActividad[]
  informesAvanceRadicados         InformeAvance[]           @relation("InformeAvanceRadicadoPor")
  informesAvanceRevisados         InformeAvance[]           @relation("InformeAvanceRevisadoPor")
  evidenciasAvanceCargadas        EvidenciaAvance[]
  seguimientosEticosDefinidos     SeguimientoEtico[]
  reportesEticosRadicados         ReporteSeguimientoEtico[]  @relation("ReporteEticoRadicadoPor")
  reportesEticosConceptuados      ReporteSeguimientoEtico[]  @relation("ReporteEticoConceptuadoPor")
  novedadesSolicitadas            NovedadProyecto[]         @relation("NovedadSolicitadaPor")
  novedadesDecididas              NovedadProyecto[]         @relation("NovedadDecididaPor")
  informesFinalesRadicados        InformeFinal[]            @relation("InformeFinalRadicadoPor")
  informesFinalesRevisados        InformeFinal[]            @relation("InformeFinalRevisadoPor")
  actasCierreGeneradas            ActaCierre[]
  reaperturasAutorizadas          ReaperturaProyecto[]

  @@map("usuarios")
}
model Rol {
  id_rol      Int            @id @default(autoincrement())
  nombre      String         @unique
  descripcion String?
  estado      Boolean        @default(true)
  permisos    PermisosRol[]
  usuarios    RolesUsuario[]

  @@map("rol")
}

model RolesUsuario {
  id_rolesusuario Int     @id @default(autoincrement())
  id_usuario      Int
  id_rol          Int
  rol             Rol     @relation(fields: [id_rol], references: [id_rol])
  usuario         Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@unique([id_usuario, id_rol])
  @@map("roles_usuario")
}

model Permiso {
  id_permiso  Int           @id @default(autoincrement())
  nombre      String
  descripcion String?
  roles       PermisosRol[]

  @@map("permisos")
}

model PermisosRol {
  id_permisosrol Int     @id @default(autoincrement())
  id_rol         Int
  id_permiso     Int
  permiso        Permiso @relation(fields: [id_permiso], references: [id_permiso])
  rol            Rol     @relation(fields: [id_rol], references: [id_rol])

  @@unique([id_rol, id_permiso])
  @@map("permisosrol")
}

model TipoProyecto {
  id_tipo_proyecto Int        @id @default(autoincrement())
  nombre           String
  proyectos        Proyecto[]

  @@map("tipo_proyecto")
}

model ModalidadProyecto {
  id_modalidad Int        @id @default(autoincrement())
  nombre       String
  descripcion  String?
  proyectos    Proyecto[]

  @@map("modalidad_proyecto")
}

model AreaConocimiento {
  id_area_conocimiento Int     @id @default(autoincrement())
  nombre               String @unique
  descripcion          String?
  proyectos            ProyectoArea[]

  @@map("area_conocimiento")
}

// Etapas del flujo institucional de revisión y evaluación de proyectos
// (general/inicial, comité de investigación, ética, pares). Usado por
// Tipo_documento para saber en qué etapa se solicita cada documento.
model Etapa {
  id_etapa    Int    @id @default(autoincrement())
  nombre      String @unique
  descripcion String?

  tiposDocumento      TipoDocumento[]
  transicionesOrigen  TransicionEtapa[] @relation("EtapaOrigen")
  transicionesDestino TransicionEtapa[] @relation("EtapaDestino")
  asignaciones        AsignacionRevision[]
  evaluaciones        EvaluacionEtapa[]
  historial           HistorialEtapaEstado[]
  observaciones       ObservacionProyecto[]

  @@map("etapas")
}

model Convocatoria {
  id_convocatoria Int        @id @default(autoincrement())
  nombre          String
  descripcion     String?
  fecha_inicio    DateTime
  fecha_fin       DateTime
  estado          String
  creado_por      Int
  fecha_creacion  DateTime   @default(now())
  creador         Usuario    @relation(fields: [creado_por], references: [id_usuario])
  proyectos       Proyecto[]

  @@map("convocatoria")
}

// Entidad principal del sistema: almacena la información general,
// académica, metodológica y administrativa de los proyectos de
// investigación registrados (según el diccionario de datos del proyecto).
model Proyecto {
  id_proyecto           Int      @id @default(autoincrement())
  id_convocatoria       Int
  id_modalidad_proyecto Int
  id_tipo_proyecto      Int
  creado_por            Int

  // Nota: en el diccionario original "estado_actual" aparece como "FK a
  // estados_proceso o string controlado". Como todavía no existe una tabla
  // de estados en este proyecto (y `convocatoria.estado` ya se maneja como
  // texto simple), lo dejamos como String por consistencia con esa
  // convención. Si más adelante se crea una tabla `estado`, se puede migrar
  // a FK sin tocar el resto del sistema.
  estado_actual         String   @default("pendiente")

  fecha_registro        DateTime @default(now())

  titulo                String
  ciudad                String?
  departamento          String?

  resumen                       String?
  planteamiento_problema        String?
  pregunta_investigacion        String?
  justificacion                 String?
  marco_teorico                 String?
  metodologia_preliminar        String?
  componente_etico               String?
  funciones_estudiante_auxiliar String?
  duracion_periodos Int?

  convocatoria Convocatoria      @relation(fields: [id_convocatoria], references: [id_convocatoria])
  modalidad    ModalidadProyecto @relation(fields: [id_modalidad_proyecto], references: [id_modalidad])
  tipoProyecto TipoProyecto      @relation(fields: [id_tipo_proyecto], references: [id_tipo_proyecto])
  creador      Usuario           @relation(fields: [creado_por], references: [id_usuario])
  participantes UsuarioProyecto[]
  areas         ProyectoArea[]
  programas     ProyectoPrograma[]
  grupos        ProyectoGrupo[]
  financiacion  Financiacion?
  objetivos     Objetivo[]
  antecedentes  Antecedente[]
  actividades   CronogramaActividad[]
  productos     ProyectoProducto[]
  documentos    ProyectoDocumento[]
  referencias   Referencia[]
  asignacionesRevision AsignacionRevision[]
  evaluaciones         EvaluacionEtapa[]
  historialEtapaEstado HistorialEtapaEstado[]

  // Campos complementarios etapa de seguimiento (v2)
  centro_costos                 String?
  id_tipo_articulacion          Int?
  fecha_inicio_real             DateTime?
  fecha_fin_real                DateTime?
  duracion_meses                Int?

  tipoArticulacion              TipoArticulacion?         @relation(fields: [id_tipo_articulacion], references: [id_tipo_articulacion])
  actasInicio                   ActaInicio[]
  solicitudesRubro              SolicitudRubro[]
  periodosInforme               PeriodoInforme[]
  informesAvance                InformeAvance[]
  seguimientoEtico              SeguimientoEtico?
  novedades                     NovedadProyecto[]
  informesFinales               InformeFinal[]
  equiposAdquiridos             EquipoAdquirido[]
  materialBibliografico         MaterialBibliografico[]
  actasCierre                   ActaCierre[]
  reaperturas                   ReaperturaProyecto[]

  @@map("proyectos")
}
// RQF03 - Recuperación de contraseña: guarda tokens de un solo uso y con
// expiración. Se almacena el HASH del token (nunca el token en texto plano);
// el valor sin hashear solo se envía una vez, por correo/enlace al usuario.
model TokenRecuperacion {
  id_token   Int      @id @default(autoincrement())
  id_usuario Int
  tokenHash  String   @unique
  expira_en  DateTime
  usado      Boolean  @default(false)
  creado_en  DateTime @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("token_recuperacion")
}

// ---------------------------------------------------------------------------
// PARTICIPANTES DEL PROYECTO (RQF17)
// ---------------------------------------------------------------------------

model Dedicacion {
  id_dedicacion Int               @id @default(autoincrement())
  nombre        String            @unique // ej. TC, MT, HC
  descripcion   String?
  participantes UsuarioProyecto[]
  grupos        GrupoInvestigacion[]

  @@map("dedicacion")
}

model RolProyecto {
  id_rol_pro    Int               @id @default(autoincrement())
  nombre        String            @unique // ej. Investigador Principal, Estudiante Investigador
  descripcion   String?
  participantes UsuarioProyecto[]

  @@map("rol_proyecto")
}

model RolEstudiante {
  id_rolestudiante Int               @id @default(autoincrement())
  nombre           String            @unique // asistente, auxiliar
  descripcion      String?
  participantes    UsuarioProyecto[]

  @@map("rol_estudiante")
}

// Relaciona usuarios con los proyectos en los que participan (RQF17).
model UsuarioProyecto {
  id_usuarioproyecto Int  @id @default(autoincrement())
  id_proyecto         Int
  participante         Int // FK a Usuario
  id_dedicacion        Int
  id_rol_pro           Int
  // Solo aplica cuando el rol_pro corresponde a "Estudiante Investigador";
  // se valida en la capa de servicio, no a nivel de base de datos.
  id_rol_estudiante    Int?

  proyecto      Proyecto       @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  usuario       Usuario        @relation(fields: [participante], references: [id_usuario])
  dedicacion    Dedicacion     @relation(fields: [id_dedicacion], references: [id_dedicacion])
  rolProyecto   RolProyecto    @relation(fields: [id_rol_pro], references: [id_rol_pro])
  rolEstudiante RolEstudiante? @relation(fields: [id_rol_estudiante], references: [id_rolestudiante])
  egresado      InformacionEgresado?

  // Campos complementarios etapa de seguimiento (v2)
  id_linea_investigacion        Int?
  codigo_estudiantil            String?
  fecha_vinculacion             DateTime?                 @default(now())
  fecha_desvinculacion          DateTime?
  activo                        Boolean                   @default(true)

  lineaInvestigacion            LineaInvestigacion?       @relation(fields: [id_linea_investigacion], references: [id_linea])
  compromisos                   CompromisoAceptacion[]
  salidasNovedad                NovedadParticipante[]     @relation("ParticipanteSaliente")
  entradasNovedad               NovedadParticipante[]     @relation("ParticipanteEntrante")
  participacionesEstudiante     ParticipacionEstudiante[]

  // Un mismo usuario no puede quedar registrado dos veces en el mismo proyecto
  @@unique([id_proyecto, participante])
  @@map("usuario_proyecto")
}

// ---------------------------------------------------------------------------
// ÁREA DE CONOCIMIENTO DEL PROYECTO (RQF19)
// ---------------------------------------------------------------------------

model ProyectoArea {
  id_proyecto_area     Int @id @default(autoincrement())
  id_proyectos         Int
  id_area_conocimiento Int

  proyecto Proyecto         @relation(fields: [id_proyectos], references: [id_proyecto], onDelete: Cascade)
  area     AreaConocimiento @relation(fields: [id_area_conocimiento], references: [id_area_conocimiento])

  @@unique([id_proyectos, id_area_conocimiento])
  @@map("proyecto_area")
}

// ---------------------------------------------------------------------------
// PROGRAMAS ACADÉMICOS DEL PROYECTO (RQF20)
// ---------------------------------------------------------------------------

model Facultad {
  id_facultad Int    @id @default(autoincrement())
  nombre      String @unique

  programas Programa[]
  grupos    GrupoInvestigacion[]

  @@map("facultad")
}

model TipoPrograma {
  id_tipo_programa Int    @id @default(autoincrement())
  nombre           String @unique // pregrado, posgrado

  programas Programa[]

  @@map("tipo_programa")
}

model Programa {
  id_programa      Int    @id @default(autoincrement())
  nombre           String
  id_facultad      Int
  id_tipo_programa Int

  facultad     Facultad     @relation(fields: [id_facultad], references: [id_facultad])
  tipoPrograma TipoPrograma @relation(fields: [id_tipo_programa], references: [id_tipo_programa])
  proyectos    ProyectoPrograma[]
  grupos       GrupoInvestigacion[]

  @@map("programas")
}

model ProyectoPrograma {
  id_proyecto_programas Int     @id @default(autoincrement())
  id_proyectos          Int
  id_programa           Int?
  // Se diligencia manualmente solo cuando el programa no existe en el
  // catálogo; en ese caso id_programa queda en null.
  programa_otro         String?

  proyecto Proyecto  @relation(fields: [id_proyectos], references: [id_proyecto], onDelete: Cascade)
  programa Programa? @relation(fields: [id_programa], references: [id_programa])

  @@map("proyecto_programa")
}

// ---------------------------------------------------------------------------
// FINANCIACIÓN DEL PROYECTO (RQF22) — relación 1 a 1 con Proyecto
// ---------------------------------------------------------------------------

model Financiacion {
  id_financiacion             Int     @id @default(autoincrement())
  id_proyecto                 Int     @unique
  valor_solicitado_unicesmag  Decimal @db.Decimal(14, 2)
  valor_contrapartida         Decimal @db.Decimal(14, 2) @default(0)
  valor_total                 Decimal @db.Decimal(14, 2)
  valor_ejecutado             Decimal? @db.Decimal(14, 2) @default(0)

  proyecto Proyecto @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  vigencias FinanciacionVigencia[]

  @@map("financiacion")
}

// ---------------------------------------------------------------------------
// GRUPOS DE INVESTIGACIÓN, LÍNEAS Y ODS DEL PROYECTO (RQF23, RQF25)
// ---------------------------------------------------------------------------

model TipoGrupo {
  id_tipo_grupo Int    @id @default(autoincrement())
  nombre        String @unique // interno, externo

  grupos GrupoInvestigacion[]

  @@map("tipo_grupo")
}

model LineaInvestigacion {
  id_linea    Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  proyectos ProyectoGrupo[]
  participantes UsuarioProyecto[]

  @@map("lineas_investigacion")
}

model Ods {
  id_ods      Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  proyectos ProyectoGrupo[]

  @@map("ods")
}

model GrupoInvestigacion {
  id_grupo               Int      @id @default(autoincrement())
  id_facultad             Int?
  id_programa              Int?
  id_dedicacion            Int?
  id_tipo_grupo            Int
  // Se diligencian manualmente solo si la facultad/programa no existe en
  // el catálogo (por ejemplo, grupos externos a la universidad).
  facultad_otra            String?
  programa_otro            String?
  nombre                   String
  lider_grupo              String?
  cod_gruplac              String?
  reconocido_minciencias   Boolean  @default(false)
  categoria                String?
  acuerdo_institucional    String?
  // Aplica principalmente para grupos externos.
  linea_medular            String?

  facultad   Facultad?   @relation(fields: [id_facultad], references: [id_facultad])
  programa   Programa?   @relation(fields: [id_programa], references: [id_programa])
  dedicacion Dedicacion? @relation(fields: [id_dedicacion], references: [id_dedicacion])
  tipoGrupo  TipoGrupo   @relation(fields: [id_tipo_grupo], references: [id_tipo_grupo])
  proyectos  ProyectoGrupo[]

  @@map("grupo_investigacion")
}

model ProyectoGrupo {
  id_proyecto_grupo      Int  @id @default(autoincrement())
  id_proyecto             Int
  id_grupo                 Int
  id_linea_investigacion    Int?
  id_ods                    Int?

  proyecto           Proyecto            @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  grupo              GrupoInvestigacion  @relation(fields: [id_grupo], references: [id_grupo])
  lineaInvestigacion LineaInvestigacion? @relation(fields: [id_linea_investigacion], references: [id_linea])
  ods                Ods?                @relation(fields: [id_ods], references: [id_ods])

  @@unique([id_proyecto, id_grupo])
  @@map("proyecto_grupo")
}

// ---------------------------------------------------------------------------
// INFORMACIÓN DE EGRESADOS VINCULADOS AL PROYECTO (RQF24)
// ---------------------------------------------------------------------------

model InformacionEgresado {
  id_egresado                 Int     @id @default(autoincrement())
  id_usuarioproyecto          Int     @unique
  facultad                    String?
  programa_academico          String?
  empresa_entidad              String?
  dedicacion_horas_semanales   Int?

  usuarioProyecto UsuarioProyecto @relation(fields: [id_usuarioproyecto], references: [id_usuarioproyecto], onDelete: Cascade)

  @@map("informacion_egresado")
}

// ---------------------------------------------------------------------------
// OBJETIVOS, ANTECEDENTES E IMPACTOS DEL PROYECTO (RQF27, RQF28)
// ---------------------------------------------------------------------------

model Objetivo {
  id_objetivo   Int    @id @default(autoincrement())
  id_proyecto   Int
  tipo_objetivo String // "general" | "especifico"
  descripcion   String

  proyecto Proyecto @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  impactos Impacto[]
  metas    MetaObjetivo[]
  actividadesCronograma CronogramaActividad[]
  cumplimientosFinales  CumplimientoObjetivo[]

  @@map("objetivos")
}

model Antecedente {
  id_antecedente     Int       @id @default(autoincrement())
  id_proyecto        Int
  descripcion        String
  fecha_publicacion  DateTime?
  autor              String?
  fuente             String?

  proyecto Proyecto @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)

  @@map("antecedentes")
}

model Impacto {
  id_impacto              Int    @id @default(autoincrement())
  id_objetivo             Int
  impacto_esperado        String
  beneficiario_potencial  String?
  indicador_verificable   String?

  objetivo Objetivo @relation(fields: [id_objetivo], references: [id_objetivo], onDelete: Cascade)

  @@map("impacto")
}

// ---------------------------------------------------------------------------
// CRONOGRAMA DE ACTIVIDADES DEL PROYECTO (RQF29)
// ---------------------------------------------------------------------------

model Periodo {
  id_periodo Int    @id @default(autoincrement())
  nombre     String @unique // ej. Periodo I, Periodo II

  cronograma CronogramaPeriodoMes[]

  @@map("periodo")
}

model CronogramaActividad {
  id_actividad Int    @id @default(autoincrement())
  id_proyecto  Int
  responsable  Int // FK a Usuario
  actividad    String
  resultado    String?
  id_objetivo  Int?
  id_meta      Int?

  proyecto           Proyecto               @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  usuarioResponsable Usuario                @relation(fields: [responsable], references: [id_usuario])
  periodos           CronogramaPeriodoMes[]
  objetivo           Objetivo?              @relation(fields: [id_objetivo], references: [id_objetivo])
  meta               MetaObjetivo?          @relation(fields: [id_meta], references: [id_meta])
  avancesActividad   InformeAvanceActividad[]

  @@map("cronograma_actividad")
}

model CronogramaPeriodoMes {
  id_cronograma_periodo_mes Int @id @default(autoincrement())
  id_actividad              Int
  id_periodo                Int
  año                       Int
  mes                       Int // 1-12

  actividad CronogramaActividad @relation(fields: [id_actividad], references: [id_actividad], onDelete: Cascade)
  periodo   Periodo             @relation(fields: [id_periodo], references: [id_periodo])

  @@map("cronograma_periodo_mes")
}

// ---------------------------------------------------------------------------
// PRODUCTOS DE INVESTIGACIÓN (RQF30, RQF31, RQF32)
// ---------------------------------------------------------------------------

model CategoriaProducto {
  id_categoria Int    @id @default(autoincrement())
  nombre       String @unique

  subcategorias SubcategoriaProducto[]

  @@map("categoria_producto")
}

model SubcategoriaProducto {
  id_subcategoria Int    @id @default(autoincrement())
  id_categoria    Int
  nombre          String

  categoria CategoriaProducto @relation(fields: [id_categoria], references: [id_categoria], onDelete: Cascade)
  tipos     TipoProducto[]

  @@map("subcategoria_producto")
}

model TipoProducto {
  id_tipo_producto Int     @id @default(autoincrement())
  id_subcategoria  Int
  nombre           String
  // RQF31 - marca los productos que todo proyecto debe comprometer como
  // mínimo (se valida en /api/proyectos/:id/productos/validacion).
  obligatorio      Boolean @default(false)

  subcategoria SubcategoriaProducto @relation(fields: [id_subcategoria], references: [id_subcategoria], onDelete: Cascade)
  proyectos    ProyectoProducto[]

  @@map("tipo_producto")
}

model ProyectoProducto {
  id_proyecto_producto Int @id @default(autoincrement())
  id_proyecto          Int
  id_tipo_producto     Int
  cantidad             Int @default(1)
  es_obligatorio       Boolean @default(false)

  proyecto     Proyecto     @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  tipoProducto TipoProducto @relation(fields: [id_tipo_producto], references: [id_tipo_producto])
  resultados   ResultadoProducto[]

  @@unique([id_proyecto, id_tipo_producto])
  @@map("proyecto_producto")
}

// ---------------------------------------------------------------------------
// HOJA DE VIDA RESUMIDA DE INVESTIGADORES (RQF35)
// ---------------------------------------------------------------------------

// Nota: nombre, apellido, número de documento y correo YA existen en
// Usuario (nombre, apellido, cedula, correo); no se duplican aquí. Esta
// tabla solo guarda los datos adicionales que pide el diccionario.
model HojaVida {
  id_hoja_vida           Int       @id @default(autoincrement())
  id_usuario             Int       @unique
  lugar_nacimiento       String?
  fecha_nacimiento       DateTime?
  nacionalidad           String?
  tipo_documento         String?
  numero_documento String?
  direccion              String?
  telefono               String?
  celular                String?
  cargo_actual           String?
  cargos_desempenados    String?
  titulos_academicos     String?
  produccion_cientifica  String?

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("hoja_vida")
}

// ---------------------------------------------------------------------------
// GESTIÓN DOCUMENTAL DEL PROYECTO (RQF36-39)
// ---------------------------------------------------------------------------

// RQF36 - Tipos de documentos requeridos por etapa (catálogo, solo Admin)
model TipoDocumento {
  id_tipo_documento Int     @id @default(autoincrement())
  id_etapa          Int
  nombre            String
  descripcion       String?
  // Plantilla o archivo base opcional (ej. formato en blanco a diligenciar).
  // Guarda la ruta relativa dentro de /uploads, igual que ProyectoDocumento.archivo.
  archivo           String?
  activo            Boolean @default(true)

  etapa      Etapa               @relation(fields: [id_etapa], references: [id_etapa])
  documentos ProyectoDocumento[]

  @@map("tipo_documento")
}

// RQF37 - Carga de documentos del proyecto
// RQF38 - Consulta y descarga
// RQF39 - Validación documental inicial (aprobado_rechazado)
model ProyectoDocumento {
  id_proyecto_documento Int      @id @default(autoincrement())
  id_proyecto           Int
  id_tipo_documento     Int
  cargado_por           Int
  // Ruta relativa del archivo dentro de la carpeta /uploads del servidor
  // (nunca la ruta absoluta del disco, para poder mover el proyecto de máquina).
  archivo               String
  fecha_carga           DateTime @default(now())
  // null = pendiente de revisión, true = aprobado, false = rechazado (RQF39)
  aprobado_rechazado    Boolean?

  proyecto      Proyecto      @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  tipoDocumento TipoDocumento @relation(fields: [id_tipo_documento], references: [id_tipo_documento])
    cargadoPor    Usuario       @relation(fields: [cargado_por], references: [id_usuario])
  observaciones ObservacionProyecto[]

  @@map("proyecto_documento")
}

// =============================================================================
// EP-04 EN ADELANTE — tablas del diccionario original que todavía no tenían
// endpoints/lógica construida. Se agregan aquí solo la ESTRUCTURA (según
// requisitos.md), sin servicios/controllers todavía — esos se construyen
// módulo por módulo a medida que se desarrolla cada épica.
// =============================================================================

// ---------------------------------------------------------------------------
// EP-04 - Evaluación institucional (RQF44-61)
// ---------------------------------------------------------------------------

model Estado {
  id_estado   Int     @id @default(autoincrement())
  nombre      String  @unique // pendiente, revision, aprobado, aprobado_con_correcciones, rechazado, no_cumple, finalizado
  descripcion String?

  asignaciones AsignacionRevision[]
  historial    HistorialEtapaEstado[]
  evaluaciones EvaluacionEtapa[]

  @@map("estado")
}

model TransicionEtapa {
  id_transicion    Int @id @default(autoincrement())
  id_etapa_origen  Int
  id_etapa_destino Int

  etapaOrigen  Etapa @relation("EtapaOrigen", fields: [id_etapa_origen], references: [id_etapa])
  etapaDestino Etapa @relation("EtapaDestino", fields: [id_etapa_destino], references: [id_etapa])

  @@map("transiciones_etapa")
}

model AsignacionRevision {
  id_asignacion     Int       @id @default(autoincrement())
  id_proyecto       Int
  asignado_a        Int? // nulo en casos de revisión consolidada (RQF44)
  id_etapa          Int
  id_estado         Int
  asignado_por      Int
  fecha_asignacion  DateTime  @default(now())
  fecha_limite      DateTime?
  fecha_finalizacion DateTime?

  proyecto   Proyecto @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  asignadoA  Usuario? @relation("AsignadoA", fields: [asignado_a], references: [id_usuario])
  etapa      Etapa    @relation(fields: [id_etapa], references: [id_etapa])
  estado     Estado   @relation(fields: [id_estado], references: [id_estado])
  asignadoPor Usuario @relation("AsignadoPor", fields: [asignado_por], references: [id_usuario])

  @@map("asignaciones_revision")
}

model HistorialEtapaEstado {
  id_historial  Int      @id @default(autoincrement())
  id_proyecto   Int
  id_etapa      Int
  id_estados    Int
  cambiado_por  Int
  fecha_cambio  DateTime @default(now())
  observacion   String?

  proyecto    Proyecto @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  etapa       Etapa    @relation(fields: [id_etapa], references: [id_etapa])
  estado      Estado   @relation(fields: [id_estados], references: [id_estado])
  cambiadoPor Usuario  @relation(fields: [cambiado_por], references: [id_usuario])

  @@map("historial_etapa_estado_proyecto")
}

model EvaluacionEtapa {
  id_evaluacion       Int      @id @default(autoincrement())
  id_proyecto         Int
  id_etapa            Int
  evaluado_por        Int
  resultado           Int // FK a Estado: resultado/estado asignado tras la evaluación
  comentarios         String?
  puntaje             Decimal? @db.Decimal(5, 2) // aplica para evaluación por pares
  formato_evaluacion  String? // ruta del archivo/formato usado, dentro de /uploads
  fecha_evaluacion    DateTime @default(now())

  proyecto    Proyecto @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  etapa       Etapa    @relation(fields: [id_etapa], references: [id_etapa])
  evaluadoPor Usuario  @relation(fields: [evaluado_por], references: [id_usuario])
  estado      Estado   @relation(fields: [resultado], references: [id_estado])

  reclamaciones Reclamacion[]
  pagos         PagoPar[]

  @@map("evaluacion_etapa")
}

// ---------------------------------------------------------------------------
// Referencias bibliográficas del proyecto (Marco teórico)
// ---------------------------------------------------------------------------

model Referencia {
  id_referencia Int    @id @default(autoincrement())
  id_proyecto   Int
  referencia    String

  proyecto Proyecto @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)

  @@map("referencias")
}

// ---------------------------------------------------------------------------
// EP-04 - Reclamaciones y observaciones (RQF60, RQF62-63)
// ---------------------------------------------------------------------------

model Reclamacion {
  id_reclamacion        Int       @id @default(autoincrement())
  id_evaluacion         Int
  id_usuario_reclamante Int
  id_usuario_respuesta  Int?
  motivo_reclamacion    String
  respuesta             String?
  fecha_reclamacion     DateTime  @default(now())
  fecha_respuesta       DateTime?
  estado                String    @default("pendiente") // pendiente | respondida | cerrada

  evaluacion         EvaluacionEtapa @relation(fields: [id_evaluacion], references: [id_evaluacion], onDelete: Cascade)
  usuarioReclamante  Usuario         @relation("UsuarioReclamante", fields: [id_usuario_reclamante], references: [id_usuario])
  usuarioRespuesta   Usuario?        @relation("UsuarioRespuesta", fields: [id_usuario_respuesta], references: [id_usuario])

  @@map("reclamaciones")
}

model ObservacionProyecto {
  id_observacion     Int      @id @default(autoincrement())
  proyecto_documento Int
  id_etapa           Int
  id_usuario         Int
  observacion        String
  archivo_adjunto    String?
  fecha_observacion  DateTime @default(now())

  proyectoDocumento ProyectoDocumento @relation(fields: [proyecto_documento], references: [id_proyecto_documento], onDelete: Cascade)
  etapa             Etapa             @relation(fields: [id_etapa], references: [id_etapa])
  usuario           Usuario           @relation(fields: [id_usuario], references: [id_usuario])

  @@map("observaciones_proyecto")
}

// ---------------------------------------------------------------------------
// Pares evaluadores - datos bancarios y pagos
// ---------------------------------------------------------------------------

model DatoBancarioPar {
  id_dato_bancario  Int    @id @default(autoincrement())
  id_usuario        Int
  banco             String
  tipo_cuenta       String // ahorros | corriente
  numero_cuenta     String
  titular           String
  documento_titular String

  usuario Usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  pagos   PagoPar[]

  @@map("datos_bancarios_par")
}

model PagoPar {
  id_pago           Int      @id @default(autoincrement())
  id_evaluacion     Int
  id_dato_bancario  Int
  registrado_por    Int
  valor_pago        Decimal  @db.Decimal(14, 2)
  comprobante_pago  String?
  fecha_pago        DateTime @default(now())
  pagado            Boolean  @default(false)

  evaluacion    EvaluacionEtapa @relation(fields: [id_evaluacion], references: [id_evaluacion], onDelete: Cascade)
  datoBancario  DatoBancarioPar @relation(fields: [id_dato_bancario], references: [id_dato_bancario])
  registradoPor Usuario         @relation(fields: [registrado_por], references: [id_usuario])

  @@map("pago_par")
}

// ---------------------------------------------------------------------------
// Sesiones y notificaciones (RQF04 y transversal)
// ---------------------------------------------------------------------------

model SesionUsuario {
  id_sesion        Int       @id @default(autoincrement())
  id_usuario       Int
  fecha_inicio     DateTime  @default(now())
  fecha_cierre     DateTime?
  // Se actualiza en cada petición autenticada; el middleware `autenticar`
  // la usa para cerrar la sesión automáticamente tras INACTIVIDAD_TIMEOUT_MIN
  // minutos sin actividad, sin depender solo de la expiración del JWT.
  ultima_actividad DateTime  @default(now())
  ip               String?
  dispositivo      String?
  navegador        String?
  activa           Boolean   @default(true)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("sesiones_usuario")
}

model Notificacion {
  id_notificacion    Int      @id @default(autoincrement())
  id_usuario         Int
  titulo             String
  mensaje            String
  leida              Boolean  @default(false)
  fecha_notificacion DateTime @default(now())
  enlace             String?
  tipo_evento        String?
  programada         Boolean  @default(false)
  fecha_programada   DateTime?

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("notificaciones")
}


// =============================================================================
// ETAPA DE SEGUIMIENTO, EJECUCIÓN Y CIERRE (RQF81 A RQF141 - VERSIÓN 2)
// Modelos derivados del documento TIN-SI-FR-002 v2 (02/SEP/2026)
// =============================================================================

// ---------------------------------------------------------------------------
// A. LEGALIZACIÓN Y ACTA DE INICIO (Formato INV-IC-FR-017)
// ---------------------------------------------------------------------------

model TipoArticulacion {
  id_tipo_articulacion Int        @id @default(autoincrement())
  nombre               String     @unique
  descripcion          String?
  activo               Boolean    @default(true)

  proyectos            Proyecto[]

  @@map("tipo_articulacion")
}

model ActaInicio {
  id_acta_inicio         Int       @id @default(autoincrement())
  id_proyecto            Int
  numero_acta_aprobacion String
  fecha_acta_aprobacion  DateTime
  fecha_inicio           DateTime
  duracion_meses         Int
  fecha_fin_estimada     DateTime
  archivo_generado       String?
  archivo_firmado        String?
  estado                 String    @default("en elaboracion") // en elaboracion, en firma, legalizada
  generada_por           Int
  fecha_generacion       DateTime  @default(now())
  fecha_legalizacion     DateTime?

  proyecto               Proyecto  @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  generadaPor            Usuario   @relation(fields: [generada_por], references: [id_usuario])
  compromisos            CompromisoAceptacion[]

  @@map("acta_inicio")
}

model CompromisoAceptacion {
  id_aceptacion      Int             @id @default(autoincrement())
  id_acta_inicio     Int
  id_usuarioproyecto Int
  tipo_clausula      String          // compromisos, derechos de autor, confidencialidad, tratamiento de datos
  version_texto      String?
  aceptado           Boolean         @default(false)
  fecha_aceptacion   DateTime?

  actaInicio         ActaInicio      @relation(fields: [id_acta_inicio], references: [id_acta_inicio], onDelete: Cascade)
  usuarioProyecto    UsuarioProyecto @relation(fields: [id_usuarioproyecto], references: [id_usuarioproyecto], onDelete: Cascade)

  @@map("compromiso_aceptacion")
}

model FirmaDocumento {
  id_firma               Int       @id @default(autoincrement())
  tipo_documento_firmado String    // acta_inicio, informe_avance, informe_final, acta_cierre
  id_referencia          Int
  id_usuario             Int
  rol_firmante           String    // investigador principal, co-investigador, lider de grupo, Vicerrector
  orden_firma            Int?
  firmado                Boolean   @default(false)
  fecha_firma            DateTime?
  archivo_firma          String?

  usuario                Usuario   @relation(fields: [id_usuario], references: [id_usuario])

  @@map("firma_documento")
}

// ---------------------------------------------------------------------------
// B. EJECUCIÓN PRESUPUESTAL Y RUBROS
// ---------------------------------------------------------------------------

model FinanciacionVigencia {
  id_financiacion_vigencia Int                  @id @default(autoincrement())
  id_financiacion          Int
  anio                     Int
  valor_asignado           Decimal              @db.Decimal(14, 2)
  valor_ejecutado          Decimal              @db.Decimal(14, 2) @default(0)
  valor_disponible         Decimal              @db.Decimal(14, 2)

  financiacion             Financiacion         @relation(fields: [id_financiacion], references: [id_financiacion], onDelete: Cascade)
  solicitudes              SolicitudRubro[]
  ejecuciones              EjecucionPresupuestal[]

  @@map("financiacion_vigencia")
}

model ConceptoRubro {
  id_concepto_rubro Int              @id @default(autoincrement())
  nombre            String           @unique
  antelacion_valor  Int?
  antelacion_unidad String?          // dias, meses
  descripcion       String?
  activo            Boolean          @default(true)

  solicitudes       SolicitudRubro[]

  @@map("concepto_rubro")
}

model SolicitudRubro {
  id_solicitud_rubro       Int                  @id @default(autoincrement())
  id_proyecto              Int
  id_concepto_rubro        Int
  id_financiacion_vigencia Int
  solicitado_por           Int
  descripcion              String
  valor_solicitado         Decimal              @db.Decimal(14, 2)
  fecha_solicitud          DateTime             @default(now())
  fecha_requerida          DateTime
  cumple_antelacion        Boolean              @default(true)
  estado                   String               @default("pendiente") // pendiente, aprobada, devuelta, rechazada
  decidido_por             Int?
  fecha_decision           DateTime?
  observacion_decision     String?

  proyecto                 Proyecto             @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  concepto                 ConceptoRubro        @relation(fields: [id_concepto_rubro], references: [id_concepto_rubro])
  vigencia                 FinanciacionVigencia @relation(fields: [id_financiacion_vigencia], references: [id_financiacion_vigencia])
  solicitadoPor            Usuario              @relation("SolicitadoPor", fields: [solicitado_por], references: [id_usuario])
  decididoPor              Usuario?             @relation("DecididoPor", fields: [decidido_por], references: [id_usuario])
  ejecuciones              EjecucionPresupuestal[]

  @@map("solicitud_rubro")
}

model EjecucionPresupuestal {
  id_ejecucion             Int                  @id @default(autoincrement())
  id_solicitud_rubro       Int
  id_financiacion_vigencia Int
  valor_ejecutado          Decimal              @db.Decimal(14, 2)
  fecha_ejecucion          DateTime             @default(now())
  soporte                  String?
  registrado_por           Int
  observacion              String?

  solicitud                SolicitudRubro       @relation(fields: [id_solicitud_rubro], references: [id_solicitud_rubro])
  vigencia                 FinanciacionVigencia @relation(fields: [id_financiacion_vigencia], references: [id_financiacion_vigencia])
  registradoPor            Usuario              @relation(fields: [registrado_por], references: [id_usuario])

  @@map("ejecucion_presupuestal")
}

// ---------------------------------------------------------------------------
// C. INFORMES DE AVANCE Y SEGUIMIENTO TÉCNICO (Formato INV-IC-FR-018)
// ---------------------------------------------------------------------------

model MetaObjetivo {
  id_meta               Int                      @id @default(autoincrement())
  id_objetivo           Int
  descripcion           String
  indicador             String?
  orden                 Int?

  objetivo              Objetivo                 @relation(fields: [id_objetivo], references: [id_objetivo], onDelete: Cascade)
  actividades           CronogramaActividad[]
  avancesActividad      InformeAvanceActividad[]

  @@map("meta_objetivo")
}

model PeriodoInforme {
  id_periodo_informe Int             @id @default(autoincrement())
  id_proyecto        Int
  numero_periodo     Int
  anio               Int
  fecha_apertura     DateTime
  fecha_limite       DateTime
  estado             String          @default("programado") // programado, abierto, radicado, vencido, cerrado

  proyecto           Proyecto        @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  informes           InformeAvance[]

  @@map("periodo_informe")
}

model InformeAvance {
  id_informe_avance       Int                      @id @default(autoincrement())
  id_proyecto             Int
  id_periodo_informe      Int
  radicado_por            Int
  fecha_radicacion        DateTime?
  porcentaje_avance       Decimal?                 @db.Decimal(5, 2)
  observaciones_generales String?
  archivo_generado        String?
  archivo_firmado         String?
  estado                  String                   @default("borrador") // borrador, radicado, aprobado, devuelto
  revisado_por            Int?
  fecha_revision          DateTime?
  observacion_revision    String?

  proyecto                Proyecto                 @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  periodo                 PeriodoInforme           @relation(fields: [id_periodo_informe], references: [id_periodo_informe])
  radicadoPor             Usuario                  @relation("InformeAvanceRadicadoPor", fields: [radicado_por], references: [id_usuario])
  revisadoPor             Usuario?                 @relation("InformeAvanceRevisadoPor", fields: [revisado_por], references: [id_usuario])
  actividades             InformeAvanceActividad[]

  @@map("informe_avance")
}

model InformeAvanceActividad {
  id_informe_actividad    Int                 @id @default(autoincrement())
  id_informe_avance       Int
  id_actividad            Int
  id_meta                 Int?
  responsable             Int
  estado_actividad        String              // no iniciada, en ejecucion, cumplida, aplazada
  porcentaje_cumplimiento Int                 @default(0) // 0 a 100
  observacion             String?

  informe                 InformeAvance       @relation(fields: [id_informe_avance], references: [id_informe_avance], onDelete: Cascade)
  actividad               CronogramaActividad @relation(fields: [id_actividad], references: [id_actividad])
  meta                    MetaObjetivo?       @relation(fields: [id_meta], references: [id_meta])
  usuarioResponsable      Usuario             @relation(fields: [responsable], references: [id_usuario])
  evidencias              EvidenciaAvance[]

  @@map("informe_avance_actividad")
}

model EvidenciaAvance {
  id_evidencia         Int                    @id @default(autoincrement())
  id_informe_actividad Int
  tipo_evidencia       String                 // archivo, enlace
  archivo              String?
  enlace               String?
  descripcion          String?
  cargado_por          Int
  fecha_carga          DateTime               @default(now())

  informeActividad     InformeAvanceActividad @relation(fields: [id_informe_actividad], references: [id_informe_actividad], onDelete: Cascade)
  cargadoPor           Usuario                @relation(fields: [cargado_por], references: [id_usuario])

  @@map("evidencia_avance")
}

// ---------------------------------------------------------------------------
// D. SEGUIMIENTO ÉTICO EN EJECUCIÓN (Formato INV-IC-FR-020)
// ---------------------------------------------------------------------------

model SeguimientoEtico {
  id_seguimiento_etico Int                       @id @default(autoincrement())
  id_proyecto          Int                       @unique
  requiere_seguimiento Boolean                   @default(false)
  justificacion        String?
  periodicidad_meses   Int?
  definido_por         Int
  fecha_definicion     DateTime                  @default(now())
  estado               String                    @default("activo") // activo, cerrado, no aplica

  proyecto             Proyecto                  @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  definidoPor          Usuario                   @relation(fields: [definido_por], references: [id_usuario])
  reportes             ReporteSeguimientoEtico[]

  @@map("seguimiento_etico")
}

model ReporteSeguimientoEtico {
  id_reporte_etico   Int              @id @default(autoincrement())
  id_seguimiento_etico Int
  numero_reporte     Int
  fecha_limite       DateTime
  descripcion        String?
  novedades_eticas   String?
  evidencia          String?
  radicado_por       Int?
  fecha_radicacion   DateTime?
  concepto           String?          // cumple, cumple con observaciones, no cumple
  observacion_comite String?
  conceptuado_por    Int?
  fecha_concepto     DateTime?

  seguimiento        SeguimientoEtico @relation(fields: [id_seguimiento_etico], references: [id_seguimiento_etico], onDelete: Cascade)
  radicadoPor        Usuario?         @relation("ReporteEticoRadicadoPor", fields: [radicado_por], references: [id_usuario])
  conceptuadoPor     Usuario?         @relation("ReporteEticoConceptuadoPor", fields: [conceptuado_por], references: [id_usuario])

  @@map("reporte_seguimiento_etico")
}

// ---------------------------------------------------------------------------
// E. GESTIÓN DE NOVEDADES DEL PROYECTO
// ---------------------------------------------------------------------------

model TipoNovedad {
  id_tipo_novedad      Int               @id @default(autoincrement())
  nombre               String            @unique
  descripcion          String?
  afecta_fechas        Boolean           @default(false)
  afecta_participantes Boolean           @default(false)
  afecta_productos     Boolean           @default(false)
  activo               Boolean           @default(true)

  novedades            NovedadProyecto[]

  @@map("tipo_novedad")
}

model NovedadProyecto {
  id_novedad            Int                   @id @default(autoincrement())
  id_proyecto           Int
  id_tipo_novedad       Int
  solicitada_por        Int
  fecha_solicitud       DateTime              @default(now())
  motivo                String
  soporte               String?
  nueva_fecha_fin       DateTime?
  tiempo_prorroga_meses Int?
  acto_administrativo   String?
  estado                String                @default("pendiente") // pendiente, aprobada, rechazada
  decidido_por          Int?
  fecha_decision        DateTime?
  observacion_decision  String?

  proyecto              Proyecto              @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  tipoNovedad           TipoNovedad           @relation(fields: [id_tipo_novedad], references: [id_tipo_novedad])
  solicitadaPor         Usuario               @relation("NovedadSolicitadaPor", fields: [solicitada_por], references: [id_usuario])
  decididoPor           Usuario?              @relation("NovedadDecididaPor", fields: [decidido_por], references: [id_usuario])
  participantesModificados NovedadParticipante[]

  @@map("novedad_proyecto")
}

model NovedadParticipante {
  id_novedad_participante     Int             @id @default(autoincrement())
  id_novedad                  Int
  id_usuarioproyecto_saliente Int
  id_usuarioproyecto_entrante Int?
  motivo                      String?
  fecha_efectiva              DateTime        @default(now())

  novedad                     NovedadProyecto @relation(fields: [id_novedad], references: [id_novedad], onDelete: Cascade)
  participanteSaliente        UsuarioProyecto @relation("ParticipanteSaliente", fields: [id_usuarioproyecto_saliente], references: [id_usuarioproyecto])
  participanteEntrante        UsuarioProyecto? @relation("ParticipanteEntrante", fields: [id_usuarioproyecto_entrante], references: [id_usuarioproyecto])

  @@map("novedad_participante")
}

// ---------------------------------------------------------------------------
// F. INFORME TÉCNICO FINAL, CIERRE Y REAPERTURA (Formatos INV-IC-FR-019 y 021)
// ---------------------------------------------------------------------------

model InformeFinal {
  id_informe_final        Int                       @id @default(autoincrement())
  id_proyecto             Int
  resumen_ejecucion       String?
  observaciones_objetivos String?
  actividades_estudiantes String?
  evidencias_estudiantes  String?
  porcentaje_cumplimiento Decimal?                  @db.Decimal(5, 2)
  radicado_por            Int
  fecha_radicacion        DateTime?
  archivo_generado        String?
  archivo_firmado         String?
  estado                  String                    @default("borrador") // borrador, radicado, aprobado, devuelto
  revisado_por            Int?
  fecha_revision          DateTime?
  observacion_revision    String?

  proyecto                Proyecto                  @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  radicadoPor             Usuario                   @relation("InformeFinalRadicadoPor", fields: [radicado_por], references: [id_usuario])
  revisadoPor             Usuario?                  @relation("InformeFinalRevisadoPor", fields: [revisado_por], references: [id_usuario])
  cumplimientos           CumplimientoObjetivo[]
  resultadosProductos     ResultadoProducto[]
  participacionesEstudiantes ParticipacionEstudiante[]
  actasCierre             ActaCierre[]

  @@map("informe_final")
}

model CumplimientoObjetivo {
  id_cumplimiento          Int          @id @default(autoincrement())
  id_informe_final         Int
  id_objetivo              Int
  descripcion_cumplimiento String
  cumplido                 Boolean      @default(false)
  observacion              String?

  informeFinal             InformeFinal @relation(fields: [id_informe_final], references: [id_informe_final], onDelete: Cascade)
  objetivo                 Objetivo     @relation(fields: [id_objetivo], references: [id_objetivo])

  @@map("cumplimiento_objetivo")
}

model ResultadoProducto {
  id_resultado_producto Int              @id @default(autoincrement())
  id_proyecto_producto  Int
  id_informe_final      Int
  cantidad_proyectada   Int
  cantidad_obtenida     Int
  soporte_link          String?
  observaciones         String?
  reportado_en_cierre   Boolean          @default(false)

  proyectoProducto      ProyectoProducto @relation(fields: [id_proyecto_producto], references: [id_proyecto_producto])
  informeFinal          InformeFinal     @relation(fields: [id_informe_final], references: [id_informe_final], onDelete: Cascade)

  @@map("resultado_producto")
}

model EquipoAdquirido {
  id_equipo         Int       @id @default(autoincrement())
  id_proyecto       Int
  denominacion      String
  fecha_adquisicion DateTime?
  estado            String?
  codigo_inventario String?
  observaciones     String?

  proyecto          Proyecto  @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)

  @@map("equipo_adquirido")
}

model MaterialBibliografico {
  id_material       Int       @id @default(autoincrement())
  id_proyecto       Int
  nombre_material   String
  fecha_adquisicion DateTime?
  isbn_issn         String?
  codigo_inventario String?
  observaciones     String?

  proyecto          Proyecto  @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)

  @@map("material_bibliografico")
}

model ParticipacionEstudiante {
  id_participacion          Int             @id @default(autoincrement())
  id_informe_final          Int
  id_usuarioproyecto        Int
  codigo_estudiantil        String?
  rol_estudiante            String?
  actividades_desarrolladas String?
  evidencias                String?

  informeFinal              InformeFinal    @relation(fields: [id_informe_final], references: [id_informe_final], onDelete: Cascade)
  usuarioProyecto           UsuarioProyecto @relation(fields: [id_usuarioproyecto], references: [id_usuarioproyecto])

  @@map("participacion_estudiante")
}

model ActaCierre {
  id_acta_cierre          Int                  @id @default(autoincrement())
  id_proyecto             Int
  id_informe_final        Int
  fecha_inicio_real       DateTime
  fecha_finalizacion_real DateTime
  duracion_real_meses     Int
  paz_y_salvo             Boolean              @default(true)
  observaciones           String?
  ciudad_firma            String?
  fecha_acta              DateTime
  archivo_generado        String?
  archivo_firmado         String?
  estado                  String               @default("en elaboracion") // en elaboracion, en firma, cerrada
  generada_por            Int
  fecha_generacion        DateTime             @default(now())

  proyecto                Proyecto             @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  informeFinal            InformeFinal         @relation(fields: [id_informe_final], references: [id_informe_final])
  generadaPor             Usuario              @relation(fields: [generada_por], references: [id_usuario])
  reaperturas             ReaperturaProyecto[]

  @@map("acta_cierre")
}

model ReaperturaProyecto {
  id_reapertura      Int        @id @default(autoincrement())
  id_proyecto        Int
  id_acta_cierre     Int
  causal             String
  autorizado_por     Int
  fecha_reapertura   DateTime   @default(now())
  fecha_nuevo_cierre DateTime?

  proyecto           Proyecto   @relation(fields: [id_proyecto], references: [id_proyecto], onDelete: Cascade)
  actaCierre         ActaCierre @relation(fields: [id_acta_cierre], references: [id_acta_cierre])
  autorizadoPor      Usuario    @relation(fields: [autorizado_por], references: [id_usuario])

  @@map("reapertura_proyecto")
}
